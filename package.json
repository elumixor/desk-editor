{
  "name": "@desk/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keep's TipTap editor and Vim layer: a Markdown editor any desk app can mount, and the extensions Keep's page editor is built from.",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdown": "./src/markdown.ts",
    "./latin-key": "./src/latin-key.ts",
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check ."
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lowlight": "^3.3.0",
    "marked": "^17.0.1"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.0"
  }
}
